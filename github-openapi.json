{
  "openapi": "3.0.0",
  "info": {
    "title": "Read-only GitHub BYOK repro",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://api.github.com"
    }
  ],
  "paths": {
    "/user": {
      "get": {
        "operationId": "getAuthenticatedUser",
        "description": "Read the currently authenticated GitHub user",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}