    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:ci": "knip --exclude exports,nsExports,types,nsTypes,enumMembers,classMembers,duplicates",
    "knip:fix": "knip --fix",
    "gen:api": "node scripts/gen-api-types.mjs"
  },
  "dependencies": {
