    "json",
    "empty",
    "below_minimum",
    "shrunk",
    "not_an_object",
    "invalid",
    "unknown_block_key",
    "missing_provider",
    "unknown_timezone",
    "alias_shadows_model",
    "alias_taken",
    "duplicate_price",
    "suffix_inside_block",
    "tier_range",
    "tier_reversed",
    "tier_gap",
    "mixed_tier_basis",
    "not_priced_by_results",
    "bands_from_two_sources",
