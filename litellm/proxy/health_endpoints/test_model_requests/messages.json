{
  "turn_1": {
    "system": "<system prompt>",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What is the weather in Boston right now? First tell me in one sentence what you are about to do, then use the get_weather tool to find out.",
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ]
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "description": "Get the current weather for a city",
        "input_schema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "City name, for example Boston"
            },
            "unit": {
              "type": "string",
              "enum": [
                "celsius",
                "fahrenheit"
              ]
            }
          },
          "required": [
            "location"
          ]
        }
      }
    ],
    "thinking": {
      "type": "enabled",
      "budget_tokens": 1024
    },
    "max_tokens": 2048
  },
  "turn_2_appended_messages": [
    {
      "role": "assistant",
      "content": "<turn 1 response: assistant output>"
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "<turn 1 response: tool call id>",
          "content": "72F and sunny",
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    }
  ],
  "turn_3_appended_messages": [
    {
      "role": "assistant",
      "content": "<turn 2 response: assistant output>"
    },
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Thanks. Is that warm enough for a short walk? Repeat the temperature you found in your answer.",
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    },
    {
      "role": "system",
      "content": "<system-reminder>The user prefers short answers. Keep the temperature in the reply.</system-reminder>"
    }
  ]
}
