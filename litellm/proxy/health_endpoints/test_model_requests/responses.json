{
  "turn_1": {
    "instructions": "<system prompt>",
    "input": [
      {
        "role": "user",
        "content": "What is the weather in Boston right now? First tell me in one sentence what you are about to do, then use the get_weather tool to find out."
      }
    ],
    "tools": [
      {
        "type": "function",
        "name": "get_weather",
        "description": "Get the current weather for a city",
        "parameters": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "City name, for example Boston"
            },
            "unit": {
              "type": "string",
              "enum": [
                "celsius",
                "fahrenheit"
              ]
            }
          },
          "required": [
            "location"
          ]
        }
      }
    ],
    "reasoning": {
      "effort": "low"
    },
    "max_output_tokens": 2048
  },
  "turn_2_appended_messages": [
    "<turn 1 response: assistant output>",
    {
      "type": "function_call_output",
      "call_id": "<turn 1 response: tool call id>",
      "output": "72F and sunny"
    }
  ],
  "turn_3_appended_messages": [
    "<turn 2 response: assistant output>",
    {
      "role": "system",
      "content": "<system-reminder>The user prefers short answers. Keep the temperature in the reply.</system-reminder>"
    },
    {
      "role": "user",
      "content": "Thanks. Is that warm enough for a short walk? Repeat the temperature you found in your answer."
    }
  ]
}
