{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceListRequest",
  "type": "object",
  "properties": {
    "team_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "default": null
    },
    "api_key_hash": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "default": null
    },
    "start_ms": {
      "description": "Window start, unix ms. Default: 24h ago",
      "type": [
        "integer",
        "null"
      ],
      "format": "int64",
      "default": null
    },
    "end_ms": {
      "description": "Window end, unix ms. Default: now",
      "type": [
        "integer",
        "null"
      ],
      "format": "int64",
      "default": null
    },
    "agent": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "default": null
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "default": null
    }
  }
}
