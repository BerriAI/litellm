{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceScope",
  "type": "object",
  "properties": {
    "all_teams": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "user_id": {
      "type": "string"
    },
    "team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter_team_id": {
      "type": "string",
      "default": ""
    },
    "filter_api_key_hash": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "all_teams",
    "user_id",
    "team_ids"
  ]
}
