{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TracePage",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TraceSummary"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "data",
    "next_cursor"
  ],
  "$defs": {
    "TraceSummary": {
      "type": "object",
      "properties": {
        "resolution_limited": {
          "type": "boolean",
          "x-python-optional": true
        },
        "trace_id": {
          "type": "string"
        },
        "trace_ref": {
          "type": "string",
          "x-python-optional": true
        },
        "name": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "agent_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-python-optional": true
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-python-optional": true
        },
        "input_preview": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "duration_ms": {
          "type": "number",
          "format": "double"
        },
        "status": {
          "$ref": "#/$defs/SpanStatus"
        },
        "span_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "agent_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "agent_invocations": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "llm_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "tool_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "error_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spend": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "priced_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunSource"
            },
            {
              "type": "null"
            }
          ],
          "x-python-optional": true
        }
      },
      "required": [
        "resolution_limited",
        "trace_id",
        "trace_ref",
        "name",
        "service",
        "agent_names",
        "frameworks",
        "input_preview",
        "start_time",
        "duration_ms",
        "status",
        "span_count",
        "agent_count",
        "agent_invocations",
        "llm_calls",
        "tool_calls",
        "error_count",
        "input_tokens",
        "output_tokens",
        "models",
        "spend",
        "priced_calls"
      ]
    },
    "SpanStatus": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "unset"
      ]
    },
    "RunSource": {
      "description": "The conversation that started the run, from the `agent.source.*` span attributes.",
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/RunSourceType"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "user": {
          "description": "Who started the conversation, e.g. the Slack user's email.",
          "type": "string",
          "x-python-optional": true
        }
      },
      "required": [
        "type",
        "url",
        "title"
      ]
    },
    "RunSourceType": {
      "type": "string",
      "enum": [
        "slack",
        "teams",
        "discord",
        "linear",
        "github",
        "jira",
        "custom"
      ]
    }
  }
}
