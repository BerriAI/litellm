{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceAgentsParams",
  "description": "Same access shape as `list_traces`: every team, the caller's own traces, or their teams' traces.",
  "type": "object",
  "properties": {
    "all_teams": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "user_id": {
      "type": "string"
    },
    "team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter_team_id": {
      "type": "string",
      "default": ""
    },
    "filter_api_key_hash": {
      "type": "string",
      "default": ""
    },
    "start_ms": {
      "type": "integer",
      "format": "int64",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "end_ms": {
      "type": "integer",
      "format": "int64",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "additionalProperties": false,
  "required": [
    "all_teams",
    "user_id",
    "team_ids",
    "start_ms",
    "end_ms",
    "limit"
  ]
}
