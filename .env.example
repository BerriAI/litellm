# Development Configs
# Generate one with: echo "LITELLM_MASTER_KEY=sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY = ""
DATABASE_URL = "postgresql://llmproxy:dbpassword9090@db:5432/litellm"
STORE_MODEL_IN_DB = "True"

# Worker heartbeat interval in seconds; 0 disables heartbeat writes and worker counts
# Set the same value on all workers sharing a database, then restart them
# Invalid values fall back to 60; other background jobs must be configured separately for idle databases
PROXY_WORKER_HEARTBEAT_INTERVAL_SECONDS = "60"
