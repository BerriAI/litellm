{
  "name": "500k to 1M token bodies at rising rates: request parsing CPU, memory and bandwidth",
  "stages": [
    {"duration_s": 300, "rps": 0.5},
    {"duration_s": 300, "rps": 1},
    {"duration_s": 300, "rps": 2},
    {"duration_s": 300, "rps": 4},
    {"duration_s": 300, "rps": 8}
  ],
  "warmup_s": 30,
  "keys": {"file": "out/keys.txt", "zipf_s": 0},
  "models": {"chat": {"prefix": "chat-", "count": 10}, "messages": {"prefix": "msg-", "count": 10}},
  "classes": [
    {"name": "huge-messages", "weight": 1, "endpoint": "messages", "stream_fraction": 0.5,
     "context_tokens": {"dist": "uniform", "min": 500000, "max": 1000000},
     "ttft_ms": {"dist": "uniform", "min": 1000, "max": 3000},
     "duration_s": {"dist": "uniform", "min": 5, "max": 60}},
    {"name": "huge-chat", "weight": 1, "endpoint": "chat", "stream_fraction": 0.5,
     "context_tokens": {"dist": "uniform", "min": 500000, "max": 1000000},
     "ttft_ms": {"dist": "uniform", "min": 1000, "max": 3000},
     "duration_s": {"dist": "uniform", "min": 5, "max": 60}}
  ]
}
