{
  "name": "1M-token streams (chat up to 920k, under its 922k window) at rising rates (0.5 to 8 rps, 3 minutes each): parsing CPU, memory per open stream and first-byte time at the largest context",
  "stages": [
    {"duration_s": 180, "rps": 0.5},
    {"duration_s": 180, "rps": 1},
    {"duration_s": 180, "rps": 2},
    {"duration_s": 180, "rps": 4},
    {"duration_s": 180, "rps": 8}
  ],
  "nonstream_max_s": 360,
  "warmup_s": 30,
  "keys": {"file": "out/keys.txt", "zipf_s": 0},
  "models": {"chat": {"prefix": "gpt-6-astra-", "count": 10}, "messages": {"prefix": "claude-opus-5-5-", "count": 10}},
  "classes": [
    {"name": "stream-1m-messages", "weight": 1, "endpoint": "messages", "stream_fraction": 1,
     "context_tokens": {"dist": "uniform", "min": 950000, "max": 1000000},
     "ttft_ms": {"dist": "uniform", "min": 1000, "max": 3000},
     "duration_s": {"dist": "uniform", "min": 5, "max": 60}},
    {"name": "stream-1m-chat", "weight": 1, "endpoint": "chat", "stream_fraction": 1,
     "context_tokens": {"dist": "uniform", "min": 870000, "max": 920000},
     "ttft_ms": {"dist": "uniform", "min": 1000, "max": 3000},
     "duration_s": {"dist": "uniform", "min": 5, "max": 60}}
  ]
}
