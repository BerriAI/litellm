{
  "type": "object",
  "additionalProperties": false,
  "required": ["tier", "change_kind", "blast_radius", "reasons", "look_at"],
  "properties": {
    "tier": { "type": "string", "enum": ["low", "medium", "high"] },
    "change_kind": {
      "type": "string",
      "enum": ["additive", "scoped_behavior_change", "default_behavior_change", "public_api_change", "price_change"]
    },
    "blast_radius": {
      "type": "string",
      "enum": ["one_provider_or_page", "shared_helper", "request_hot_path", "boot_path"]
    },
    "reasons": {
      "type": "string",
      "minLength": 1,
      "description": "One to five short sentences of evidence for the tier, one per line."
    },
    "look_at": {
      "type": "string",
      "description": "Up to five file paths or symbols a human should read first, one per line. Empty for low."
    }
  }
}
