{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Who sent a batch of spans. Always taken from the caller's authentication, never from span\nattributes.",
  "properties": {
    "api_key_hash": {
      "type": "string"
    },
    "org_id": {
      "default": "",
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "user_id": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "team_id",
    "api_key_hash"
  ],
  "title": "Tenant",
  "type": "object"
}
