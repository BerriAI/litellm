      },
      "required": [
        "span_id",
        "parent_span_id",
        "name",
        "type",
        "agent",
        "framework",
        "start_offset_ms",
        "duration_ms",
        "status",
        "error",
        "error_truncated",
        "input_preview",
        "model",
        "input_tokens",
        "output_tokens",
        "litellm_request_id",
        "spend",
        "spend_log_request_id",
        "spend_match"
