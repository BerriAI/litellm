        },
        "input_preview": {
          "type": "string"
        },
        "input_tokens": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "llm_calls": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "models": {
