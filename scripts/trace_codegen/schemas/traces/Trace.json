        },
        "name": {
          "type": "string"
        },
        "output_tokens": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "priced_calls": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "resolution_limited": {
          "type": "boolean",
          "x-python-optional": true
        },
        "service": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunSource"
            },
            {
              "type": "null"
            }
          ],
          "x-python-optional": true
        },
        "span_count": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "spend": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "start_time": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SpanStatus"
        },
        "tool_calls": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "trace_id": {
          "type": "string"
        },
        "trace_ref": {
          "type": "string",
