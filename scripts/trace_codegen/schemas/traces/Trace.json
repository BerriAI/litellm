        "duration_ms": {
          "format": "double",
          "type": "number"
        },
        "error_count": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "frameworks": {
          "items": {
            "type": "string"
          },
          "type": "array",
