{
  "$defs": {
    "SpanStatus": {
      "enum": [
        "ok",
        "error",
        "unset"
      ],
      "type": "string"
    },
    "TraceSummary": {
      "properties": {
        "agent_count": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "agent_invocations": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "agent_names": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-python-optional": true
        },
        "duration_ms": {
          "format": "double",
          "type": "number"
        },
        "error_count": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "frameworks": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-python-optional": true
        },
        "input_preview": {
          "type": "string"
        },
        "input_tokens": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "llm_calls": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "output_tokens": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "resolution_limited": {
          "type": "boolean",
          "x-python-optional": true
        },
        "service": {
          "type": "string"
        },
        "span_count": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "spend": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "start_time": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SpanStatus"
        },
        "tool_calls": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "trace_id": {
          "type": "string"
        },
        "trace_ref": {
          "type": "string",
          "x-python-optional": true
        }
      },
      "required": [
        "resolution_limited",
        "trace_id",
        "trace_ref",
        "name",
        "service",
        "agent_names",
        "frameworks",
        "input_preview",
        "start_time",
        "duration_ms",
        "status",
        "span_count",
        "agent_count",
        "agent_invocations",
        "llm_calls",
        "tool_calls",
        "error_count",
        "input_tokens",
        "output_tokens",
        "models",
        "spend"
      ],
      "type": "object"
    },
    "Traversal": {
      "description": "The pinned traversal a page belongs to. Every page of one traversal shares `id`, sees the\ndata as published at `published_at`, and can be continued until `expires_at`.",
      "properties": {
        "expires_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "published_at",
        "expires_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One page of an ordered traversal: a complete ordered prefix of what remains, and either the\nopaque cursor for the rest or `None` when the traversal is exhausted.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TraceSummary"
      },
      "type": "array"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "traversal": {
      "$ref": "#/$defs/Traversal"
    }
  },
  "required": [
    "items",
    "next_cursor",
    "traversal"
  ],
  "title": "TracePage",
  "type": "object"
}
