      "required": [
        "resolution_limited",
        "trace_id",
        "id",
        "name",
        "service",
        "agent_names",
        "frameworks",
        "input_preview",
        "start_time",
        "duration_ms",
        "root_status",
        "has_error",
        "span_count",
        "agent_count",
        "agent_invocations",
        "llm_calls",
        "tool_calls",
        "error_count",
        "input_tokens",
        "output_tokens",
        "models",
        "spend"
