        "duration_ms": {
          "format": "double",
          "type": "number"
        },
        "invocations": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "llm_calls": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "parent_agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "spend": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tool_calls": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        }
