{
  "version": "0.66.0",
  "options": [
    "--input-file-type",
    "jsonschema",
    "--target-python-version",
    "3.10",
    "--disable-timestamp",
    "--custom-file-header",
    "# @generated by scripts/generate_trace_types.py, do not edit",
    "--use-standard-collections",
    "--use-union-operator",
    "--enum-field-as-literal",
    "all",
    "--use-type-alias",
    "--use-title-as-name",
    "--use-tuple-for-fixed-items",
    "--field-constraints",
    "--field-extra-keys",
    "x-python-optional",
    "x-python-normalized",
    "minimum",
    "maximum",
    "--strict-nullable",
    "--use-object-type",
    "--formatters",
    "ruff-check",
    "ruff-format"
  ]
}
