UPSTREAM_LITELLM_BASE_URL=https://gateway.litellm-sandbox.ai
UPSTREAM_LITELLM_API_KEY=sk-...   # an admin (or wide-access) virtual key on the upstream gateway
LITELLM_MASTER_KEY=sk-...         # master key clients use against THIS instance
# Optional. Without it there are no virtual keys / spend logs, only the master key.
# DATABASE_URL=postgresql://user:pass@host:5432/litellm
